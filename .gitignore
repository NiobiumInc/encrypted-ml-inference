# Build artefacts
build/
*/build/
io/
third_party/
measurements/*
!measurements/README.md
# Transport run artifacts (runs/<id>/) — regenerated per run
runs/
harness/__pycache__/
harness/mnist/__pycache__/

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib


# Executables
*.exe
*.out
*.app

# Directories
.DS_Store
.idea/
.vscode/

# Virtual environments
virtualenv

# Datasets, queries and results since we generate them on the fly
datasets/*
# But keep the folder alive with this one file, since some submissions might have fixed datasets
!datasets/.gitkeep

# Temporary files for loading MNIST data and model training
harness/mnist/data/*
harness/mnist/mnist_ffnn_model.pth

# Log files
logs/

# Ignore the environmrnt
bmenv/
# Ignore files created by the compiler
_wl_*
ml-inference_wl_*
global_key_cache_*

# backup files
*.bak

# Investigation traces and profiling artefacts
ml-inference_ems*_trace/
*.profraw

# Stale build/test dirs
submission/cmake_build/
submission/test_build/

# Python caches
scripts/__pycache__/

# Python venv for the harness deps (CI creates this; see compiler-tests.yml)
.venv/
